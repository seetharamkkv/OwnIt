    "id": "seed_test_hw1_load_visible",
    "step": { "id": "seed_assignment_cs101_hw1_load" },
    "testName": "load_data returns the CSV as a DataFrame",
    "code": "import os\nimport tempfile\n\n\ndef _write_csv(text):\n    fd, path = tempfile.mkstemp(suffix=\".csv\")\n    with os.fdopen(fd, \"w\") as f:\n        f.write(text)\n    return path\n\n\ndef test_load_returns_dataframe():\n    path = _write_csv(\"region,product,units,price\\nNorth,Pen,3,1.5\\nSouth,Ink,,2.0\\n\")\n    df = load_data(path)\n    assert isinstance(df, pd.DataFrame), f\"expected a DataFrame, got {type(df).__name__}\"\n    assert df.shape == (2, 4), f\"expected shape (2, 4), got {df.shape}\"\n",
    "visibility": "VISIBLE",
    "points": 1,
    "timeoutMs": 5000,
    "testOrder": 1
  },
